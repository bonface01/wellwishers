# Neon Postgres connection string. Use Neon's direct (non-pooled) string, i.e. the host WITHOUT "-pooler".
# (Vercel Marketplace sets this automatically; check it is the direct one.)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Password the finance person uses to log in at /admin
ADMIN_PASSWORD=change-me
# Long random string used to sign the session cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-to-a-long-random-string
# Optional: IANA timezone used to display round dates (default: Africa/Nairobi)
APP_TIMEZONE=Africa/Nairobi
